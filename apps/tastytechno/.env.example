# Copy to .env.local and supply this app's actual Sanity project and dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Fixed Content Lake API contract; this is not an SDK version.
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-12

# Public URLs. Use the corresponding deployed origin when testing a deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3004
NEXT_PUBLIC_STUDIO_URL=http://localhost:3004/studio

# Server-only Viewer token. Never use a NEXT_PUBLIC_ prefix or an Editor token.
SANITY_API_READ_TOKEN=
# No syndication write token or platform credentials are needed for Story 0.
