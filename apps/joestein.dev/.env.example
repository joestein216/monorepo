NEXT_PUBLIC_SANITY_PROJECT_ID=lt4yrzne
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01
# Viewer token from Sanity Manage. Keep the value in .env.local.
# defineLive shares it with the browser only during authenticated Draft Mode.
SANITY_API_READ_TOKEN=
# Server-only Google AI Studio key for Prompt Mode.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional server-only model override.
GEMINI_MODEL=gemini-3.5-flash-lite
